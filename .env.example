# ==============================================================================
# RISON WORKTRACK – Environment Configuration Template
# Product: Rison WorkTrack | Company: Rison AI Tech
# ==============================================================================

# Application URL (e.g. http://localhost:3000 or your custom production domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Connect to your Supabase Cloud project)
# Find these in your Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL Connection String (for direct DB pooling or migration runners)
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# OPTIONAL AI REPORTING ENGINE (PHASE 2)
# If provided, enables enhanced natural language summarization on top of real metrics.
# If omitted, system seamlessly runs built-in deterministic executive brief synthesizer.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
